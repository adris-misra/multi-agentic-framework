# Normalize all text files to LF on commit; check out as-is on the platform
* text=auto eol=lf

# Explicit Python and config rules
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.parquet binary
*.woff binary
*.woff2 binary
