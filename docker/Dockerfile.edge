# Edge node image: lightweight UNS simulator / data replay service
# Intended for resource-constrained edge hardware (RPi 4+, Intel NUC)

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/

# Install only the deps needed for the edge/simulator role
RUN pip install --no-cache-dir paho-mqtt>=2.0 pydantic>=2.5 structlog>=24.1 pandas>=2.1 numpy>=1.26

CMD ["python", "-m", "industrial_agents.tools.uns_simulator"]
