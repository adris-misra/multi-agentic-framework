# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: anthropic | openai | bedrock | ollama
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# AWS Bedrock (uses boto3 credential chain; set region + profile or key/secret)
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=my-profile
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Ollama (local; no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Industrial Data Sources ────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

OPCUA_ENDPOINT=opc.tcp://localhost:4840/
OPCUA_SECURITY_MODE=None   # None | Sign | SignAndEncrypt

# Snowflake (Adris's primary historian)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MANUFACTURING
SNOWFLAKE_SCHEMA=UNS

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# pgvector (alternative)
# PGVECTOR_DSN=postgresql://user:pass@localhost:5432/industrial_agents

# ── Governance & Security ──────────────────────────────────────────────────────
# Ed25519 signing key path (relative to repo root; dev default provided)
GOVERNANCE_SIGNING_KEY_PATH=.secrets/dev/signing_key.pem
GOVERNANCE_STORE_PATH=data/governance_log/

# OPA policy engine
OPA_BINARY=opa           # path to opa binary, or 'opa' if on PATH
OPA_POLICY_DIR=policies/

# HashiCorp Vault (optional; falls back to env vars if unset)
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=industrial-agents
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=8000

# ── HITL Escalation Channels (optional) ───────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://...
# PAGERDUTY_ROUTING_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
APP_ROLE=operator         # operator | technician | engineer | plant_manager
LOG_LEVEL=INFO
